<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MeshUp.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MeshUp.Maui"
    Title="MeshUp.Maui">

    <ShellContent
        Title="Chats"
        ContentTemplate="{DataTemplate local:ChatsListPage}"
        Route="ChatsListPage" />

    <ShellContent
        Title="Connect radio"
        ContentTemplate="{DataTemplate local:SetupPage}"
        Route="SetupPage"
        FlyoutItemIsVisible="False" />

</Shell>
